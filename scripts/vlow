#!/usr/bin/env bash
# vlow — control a source checkout's LaunchAgent from the terminal.
#
# Usage: vlow <command>
#   restart   force-restart the running instance (picks up new code)
#   stop      stop vlow (stays stopped until 'vlow start' or next login)
#   start     start vlow if not running
#   status    launchd state + last log lines
#   logs      tail the error log (Ctrl-C to stop)
#   install   (re)build dist/vlow.app, enable start-at-login, run it now
#   uninstall disable start-at-login and stop the agent
#
# Everyday use needs none of this: "Start vlow at login" in Settings writes
# the same LaunchAgent (src/vlow/login_item.py is the one place that does).
# This script is for a checkout you are developing against.

set -euo pipefail

SELF="$(readlink -f "$0")"
PROJECT_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
SERVICE="gui/$(id -u)/com.vlow"
PLIST="$HOME/Library/LaunchAgents/com.vlow.plist"
LOG_DIR="$HOME/Library/Logs/vlow"

# One plist writer for both the Settings toggle and this script.
autostart() {
  "$PROJECT_DIR/.venv/bin/python" -c \
    "from vlow import login_item; login_item.set_enabled($1)"
}

cmd="${1:-help}"
cmd="${cmd#--}"

case "$cmd" in
  restart)
    launchctl kickstart -k "$SERVICE"
    echo "vlow restarted."
    ;;
  stop)
    launchctl bootout "$SERVICE"
    echo "vlow stopped (until 'vlow start' or next login)."
    ;;
  start)
    launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null || true
    launchctl kickstart "$SERVICE"
    echo "vlow started."
    ;;
  status)
    if launchctl print "$SERVICE" >/dev/null 2>&1; then
      launchctl print "$SERVICE" | grep -E '^[[:space:]]*(state|pid)' || true
    else
      echo "not loaded (run 'vlow start')"
    fi
    echo "--- last log lines ($LOG_DIR/vlow.err):"
    tail -n 5 "$LOG_DIR/vlow.err" 2>/dev/null || echo "(no log yet)"
    ;;
  logs)
    exec tail -F "$LOG_DIR/vlow.err"
    ;;
  install)
    # The bundle exists so Privacy & Security says "vlow", not "python3.12".
    "$PROJECT_DIR/scripts/build-app-bundle.sh"
    autostart True
    echo "Wrote $PLIST"
    launchctl bootout "gui/$(id -u)" "$PLIST" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$PLIST"
    launchctl enable "$SERVICE"
    launchctl kickstart -k "$SERVICE"
    BIN_DIR="/opt/homebrew/bin"
    if [ -d "$BIN_DIR" ] && [ -w "$BIN_DIR" ]; then
      ln -sfn "$SELF" "$BIN_DIR/vlow"
      echo "Installed CLI: $BIN_DIR/vlow"
    fi
    echo "Loaded — vlow is running and will start at login. Logs: $LOG_DIR"
    ;;
  uninstall)
    launchctl bootout "$SERVICE" 2>/dev/null || true
    autostart False
    echo "Removed $PLIST — vlow no longer starts at login."
    echo "Logs in $LOG_DIR are kept; delete them by hand if you want."
    ;;
  help|*)
    sed -n '2,15p' "$SELF" | sed 's/^# \{0,1\}//'
    ;;
esac
